{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
      "allow": [
        "Bash(bash -n:*)",
        "Bash(git status:*)",
        "Bash(git diff:*)",
        "Bash(git log:*)",
        "Bash(git show:*)",
        "Bash(git branch:*)"
      ],
      "deny": [
        "Bash(git push --force:*)",
        "Bash(git push -f:*)"
      ]
    },
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
        "Bash(git branch:*)"
      ],
      "deny": [
        "Bash(git push --force:*)",
        "Bash(git push -f:*)"
      ]
    },
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
  pháp bash trong $f (người dùng chạy thẳng từ main, phải sửa trước khi commit):\" >&2; echo \"$out\" >&2; exit 2; };; esac"
            }
          ]
        }
      ]
    }
  }
}